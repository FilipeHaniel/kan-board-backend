// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  goals     Goal[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Goal {
  id            String         @id @default(uuid())
  title         String
  /// Ex: ENEM 2026
  examDate      DateTime?
  userId        String
  user          User           @relation(fields: [userId], references: [id])
  subjects      Subject[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  studySessions StudySession[]
}

model Subject {
  id        String     @id @default(uuid())
  name      String
  goalId    String
  goal      Goal       @relation(fields: [goalId], references: [id])
  divisions Division[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Division {
  id        String    @id @default(uuid())
  name      String
  /// Ex:
  /// Frente A
  /// Frente B
  /// Frente Única
  subjectId String
  subject   Subject   @relation(fields: [subjectId], references: [id])
  contents  Content[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Content {
  id         String        @id @default(uuid())
  /// Ex:
  /// Funções
  /// Equações
  /// Trigonometria
  title      String
  status     ContentStatus @default(NOT_STARTED)
  /// Ordem visual dentro da frente
  position   Int           @default(0)
  divisionId String
  division   Division      @relation(fields: [divisionId], references: [id])
  tasks      Task[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model Task {
  id                String             @id @default(uuid())
  /// Ex:
  /// Plano Cartesiano
  /// Função Afim
  /// Tipos de Parábola
  title             String
  status            TaskStatus         @default(BACKLOG)
  /// Ordem visual dentro da coluna
  position          Int                @default(0)
  /// Opcional para planejamento futuro
  estimatedMinutes  Int?
  contentId         String
  content           Content            @relation(fields: [contentId], references: [id])
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  studySessionTasks StudySessionTask[]
}

model StudySession {
  id         String             @id @default(uuid())
  /// Goal info
  goalId     String
  goal       Goal               @relation(fields: [goalId], references: [id])
  /// Timer session
  startedAt  DateTime           @default(now())
  finishedAt DateTime?
  createdAt  DateTime           @default(now())
  /// Tasks feature
  tasks      StudySessionTask[]
}

model StudySessionTask {
  id                String       @id @default(uuid())
  /// Session info
  studySessionId    String
  studySession      StudySession @relation(fields: [studySessionId], references: [id])
  /// Tasks info
  taskId            String
  task              Task         @relation(fields: [taskId], references: [id])
  /// timer study session
  completedAt       DateTime?
  durationInMinutes Int?
  difficulty        Int?
  wasInterrupted    Boolean      @default(false)
  reviewScheduled   Boolean      @default(false)
}

enum ContentStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
}

enum TaskStatus {
  BACKLOG
  TODAY
  DONE
}
